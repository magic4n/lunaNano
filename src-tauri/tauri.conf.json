{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devPath": "http://localhost:5173",
    "distDir": "../dist"
  },
  "package": {
    "productName": "lunanano",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "execute": true,
        "open": true
      },
      "window": {
        "all": true
      }
    },
    "bundle": {
      "active": true,
      "category": "Utility",
      "copyright": "superLuna Ecosystem",
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libgtk-3-0",
          "pipewire",
          "wireplumber",
          "brightnessctl",
          "network-manager",
          "bluez",
          "power-profiles-daemon",
          "wl-clipboard",
          "grim",
          "slurp",
          "wf-recorder",
          "xwayland"
        ]
      },
      "externalBin": [],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "identifier": "org.superluna.lunanano",
      "longDescription": "LunaNano — Ultra-lightweight aesthetic Wayland Desktop Shell built with React, TypeScript & Material You 3",
      "shortDescription": "LunaNano Wayland Desktop Shell",
      "targets": ["deb", "appimage"]
    },
    "security": {
      "csp": null
    },
    "updater": {
      "active": false
    },
    "windows": [
      {
        "fullscreen": true,
        "height": 1080,
        "resizable": false,
        "title": "LunaNano Shell",
        "width": 1920,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": false
      }
    ]
  }
}
